<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :all, "data-turbo-track": "reload" %>
  </head>
  <body class="room-settings-sheet"
      data-controller="project-users-sheet"
      data-project-users-sheet-refresh-project-settings-value="<%= params[:refresh_project_settings] == "true" %>">
    <section class="room-settings-sheet__panel">
      <header class="room-settings-sheet__header">
        <h1 class="room-settings-sheet__title"><%= @project.display_name %> Users</h1>
      </header>

      <section class="room-settings-sheet__actions">
        <details class="room-settings-sheet__picker">
          <summary class="btn room-settings-sheet__add-btn">+ Add User</summary>
          <%= form_with url: rooms_project_users_settings_path(@project), method: :patch, class: "room-settings-sheet__picker-form" do %>
            <%= hidden_field_tag :intent, "add_user" %>
            <label class="for-screen-reader" for="project_participant_user">Pick user</label>
            <%= select_tag :participant_id,
                  options_from_collection_for_select(@available_users, :id, :name),
                  id: "project_participant_user",
                  class: "input full-width",
                  disabled: @available_users.empty? %>
            <button type="submit" class="btn btn--reversed" <%= "disabled" if @available_users.empty? %>>Add</button>
          <% end %>
        </details>

        <details class="room-settings-sheet__picker">
          <summary class="btn room-settings-sheet__add-btn">+ Add AI Teammate</summary>
          <%= form_with url: rooms_project_users_settings_path(@project), method: :patch, class: "room-settings-sheet__picker-form" do %>
            <%= hidden_field_tag :intent, "add_agent" %>
            <label class="for-screen-reader" for="project_participant_agent">Pick AI teammate</label>
            <%= select_tag :participant_id,
                options_for_select(@available_ai_teammate_options),
                  id: "project_participant_agent",
                  class: "input full-width",
                disabled: @available_ai_teammate_options.empty? %>
              <button type="submit" class="btn btn--reversed" <%= "disabled" if @available_ai_teammate_options.empty? %>>Add</button>
          <% end %>
        </details>
      </section>

      <ul class="room-settings-sheet__members margin-none">
        <% @users.each do |user| %>
          <li class="room-settings-sheet__member">
            <span class="room-settings-sheet__avatar room-settings-sheet__avatar--user"><%= user.name.first.upcase %></span>
            <div class="room-settings-sheet__member-name-wrap">
              <strong class="room-settings-sheet__member-name"><%= user.name %></strong>
              <span class="room-settings-sheet__member-type">(Human)</span>
            </div>

            <% if user != Current.user %>
              <%= form_with url: rooms_project_users_settings_path(@project), method: :patch, class: "room-settings-sheet__remove-form" do %>
                <%= hidden_field_tag :intent, "remove_user" %>
                <%= hidden_field_tag :participant_id, user.id %>
                <button type="submit" class="btn room-settings-sheet__remove-btn">Remove</button>
              <% end %>
            <% end %>
          </li>
        <% end %>

        <% @bot_users.each do |bot_user| %>
          <li class="room-settings-sheet__member">
            <span class="room-settings-sheet__avatar room-settings-sheet__avatar--agent"><%= bot_user.name.first.upcase %></span>
            <div class="room-settings-sheet__member-name-wrap">
              <strong class="room-settings-sheet__member-name"><%= bot_user.name %></strong>
              <span class="room-settings-sheet__member-type">(AI)</span>
            </div>

            <%= form_with url: rooms_project_users_settings_path(@project), method: :patch, class: "room-settings-sheet__remove-form" do %>
              <%= hidden_field_tag :intent, "remove_agent" %>
              <%= hidden_field_tag :participant_id, "User:#{bot_user.id}" %>
              <button type="submit" class="btn room-settings-sheet__remove-btn">Remove</button>
            <% end %>
          </li>
        <% end %>

      </ul>
    </section>
  </body>
</html>
