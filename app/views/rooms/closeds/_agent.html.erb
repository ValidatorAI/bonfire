<li class="flex align-center gap margin-none" data-value="<%= agent.name.downcase %>">
  <figure class="avatar avatar--agent flex-item-no-shrink" style="--avatar-size: 4ch;">
    <%= agent_avatar_tag agent %>
  </figure>

  <div class="min-width">
    <div class="overflow-ellipsis fill-shade">
      <strong><%= agent.name %></strong>
      <span class="badge--agent">Agent</span>
    </div>
    <div class="txt-small txt-secondary overflow-ellipsis"><%= agent.program %></div>
  </div>

  <hr class="separator" aria-hidden="true">

  <% if agent.online? %>
    <span class="presence-indicator presence--online" title="Online"></span>
  <% else %>
    <span class="presence-indicator presence--offline" title="Offline"></span>
  <% end %>
</li>
