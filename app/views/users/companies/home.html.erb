<% @page_title = "Home" %>
<% @body_class = "sidebar" %>

<% content_for :nav do %>
  <%= account_logo_tag %>
  <h1 class="user-settings-nav__title txt-large">Home</h1>
<% end %>

<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>

<div id="message-area" class="message-area" data-controller="home-attention">
  <div class="home-attention-feed">
    <div class="home-attention-header">
      <h2>What needs your attention?</h2>
      <span class="badge red" data-home-attention-target="openBadge"><%= @open_count %> Open</span>
    </div>
    <p class="home-attention-subtitle">Action-only inbox: decisions, blockers, reviews, AI confirmations, and knowledge approvals. For full context, open Status.</p>

    <div class="home-signal-strip">
      <div class="home-signal-card">
        <span class="home-signal-label">Open Attention</span>
        <span class="home-signal-value" data-home-attention-target="openCount"><%= @open_count %></span>
      </div>
      <div class="home-signal-card">
        <span class="home-signal-label">Overdue Today</span>
        <span class="home-signal-value" data-home-attention-target="overdueCount"><%= @overdue_count %></span>
      </div>
      <div class="home-signal-card">
        <span class="home-signal-label">AI Awaiting Confirmation</span>
        <span class="home-signal-value" data-home-attention-target="aiCount"><%= @ai_count %></span>
      </div>
    </div>

    <div class="home-attention-grid">
      <% AttentionItem::CATEGORIES.each do |cat| %>
        <% items = @items_by_category[cat] || [] %>
        <div class="home-attention-card" data-home-attention-target="card" data-category="<%= cat %>">
          <h3>
            <%= AttentionItem.category_title(cat) %>
            <span class="badge <%= AttentionItem.category_badge_class(cat) %> home-card-count"><%= items.count %></span>
          </h3>

          <div class="card-items-list">
            <% if items.any? %>
              <%= render partial: "attention_items/attention_item", collection: items %>
            <% else %>
              <div class="company-cell-muted txt-small" style="padding: 8px 0;">No active items</div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="home-empty-state" data-home-attention-target="emptyState" style="<%= 'display: block;' if @open_count.zero? %>">
      All clear. No items require your action right now.
    </div>
  </div>

  <div class="home-ask-input-area">
    <div class="home-input-pill">
      <span>✨</span>
      <input type="text" placeholder="Ask W about the company..." aria-label="Ask W about the company">
    </div>
  </div>
</div>
