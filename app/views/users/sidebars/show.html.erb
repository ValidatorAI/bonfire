<%= sidebar_turbo_frame_tag do %>
  <%= turbo_stream_from :rooms %>
  <%= turbo_stream_from Current.user, :rooms %>

  <div class="sidebar__container overflow-y overflow-hide-scrollbar"
      data-controller="badge-dot"
      data-badge-dot-unread-class="unread"
      data-action="rooms-list:unread@window->badge-dot#update rooms-list:read@window->badge-dot#update turbo:submit-start->turbo-frame#unpermanize">
    <section class="sidebar-company" aria-label="Company">
      <div class="sidebar-company__header">
        <h2 class="sidebar-company__title">Company</h2>
        <button type="button" class="btn sidebar-company__settings" aria-label="Company settings">
          <span aria-hidden="true">⚙️</span>
        </button>
      </div>

      <div class="sidebar-company__buttons flex flex-column gap">
        <button type="button" class="room btn txt-nowrap sidebar-company__button" aria-label="Company Home">
          <span aria-hidden="true">🏠</span>
          <span>Home</span>
        </button>

        <button type="button" class="room btn txt-nowrap sidebar-company__button" aria-label="Company Status">
          <span aria-hidden="true">📊</span>
          <span>Company Status</span>
        </button>
      </div>
    </section>

    <% if @projects.any? %>
      <section class="sidebar-projects" aria-label="Projects">
        <div class="sidebar-section-separator" aria-hidden="true"></div>
        <h2 class="sidebar-projects__title">Projects</h2>

        <div class="sidebar-projects__list flex flex-column gap">
          <% project_actions = [
            ["📌", "Overview"],
            ["📊", "Status"],
            ["🗣️", "All-Hands"],
            ["🧠", "Knowledge"]
          ] %>

          <% @projects.each do |project| %>
            <div class="sidebar-projects__item">
              <% project_room = project.project_room %>
              <% if project_room %>
                <% membership = @project_memberships_by_room_id[project_room.id] %>
                <%= link_to_room project_room,
                      class: [ "room btn txt-nowrap sidebar-projects__button", "unread": membership&.unread? ] do %>
                  <span class="sidebar-projects__main">
                    <span aria-hidden="true">⚡</span>
                    <span class="overflow-ellipsis sidebar-projects__name"><%= project.display_name %></span>
                  </span>
                  <span class="sidebar-projects__gear" aria-hidden="true">⚙️</span>
                <% end %>
              <% else %>
                <span class="room btn txt-nowrap sidebar-projects__button sidebar-projects__button--inactive">
                  <span class="sidebar-projects__main">
                    <span aria-hidden="true">⚡</span>
                    <span class="overflow-ellipsis sidebar-projects__name"><%= project.display_name %></span>
                  </span>
                  <span class="sidebar-projects__gear" aria-hidden="true">⚙️</span>
                </span>
              <% end %>

              <div class="sidebar-projects__actions flex flex-column gap">
                <% project_actions.each do |emoji, label| %>
                  <button type="button" class="room btn txt-nowrap sidebar-projects__action-btn" aria-label="<%= "#{project.display_name} #{label}" %>">
                    <span aria-hidden="true"><%= emoji %></span>
                    <span class="overflow-ellipsis"><%= label %></span>
                  </button>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <div class="rooms position-relative flex flex-column gap">
      <div id="shared_rooms" contents data-controller="sorted-list">
        <% @other_memberships.each do |membership| %>
          <%= render "users/sidebars/rooms/shared", room: membership.room, unread: membership.unread? %>
        <% end %>
      </div>

      <% if Current.user.administrator? || !Current.account.settings.restrict_room_creation_to_administrators? %>
        <%= link_to new_rooms_open_path, class: "rooms__new-btn btn room align-center gap", aria: { label: "New Project" } do %>
          <span class="rooms__new-btn-label">+ New project</span>
        <% end %>
      <% end %>
    </div>

    <button class="btn sidebar__toggle" data-action="toggle-class#toggle">
      <%= image_tag "menu.svg", size: 20, aria: { hidden: "true" } %>
      <span class="for-screen-reader">Open menu</span>
    </button>
  </div>

  <div class="flex align-end sidebar__tools gap justify-end">
    <%= link_to user_profile_path, class: "btn avatar flex-item-no-shrink sidebar__tool" do %>
      <%= image_tag fresh_user_avatar_path(Current.user), size: 48, aria: { hidden: "true" }, style: "view-transition-name: avatar-#{Current.user.id}" %>
      <span class="for-screen-reader">My Settings</span>
    <% end %>

    <%= link_to edit_account_path, class: "btn align-center txt-reversed sidebar__tool sidebar__tool--settings" do %>
      <span aria-hidden="true" style="view-transition-name: account-settings">⚙️</span>
      <span class="for-screen-reader">Account Settings</span>
    <% end %>
  </div>
<% end %>
